<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
    <h3>Create a new listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation">
        <div class="mb-4">
            <label for="title" class="form-label" >Title</label>
            <br>
            <input 
            name="listing[title]" 
            placeholder="enter title" 
            type="text" 
            class="form-control"
            required
            />
            <div class="invalid-feedback">Please enter a valid title</div>
        </div>
        
        
        <div class="mb-3 row-2">
           <label for="description" class="form-label" >Description</label> 
           <br>
           <input 
            name="listing[title]" 
            class="form-control"
            required
              
             
            />
            <div class="invalid-feedback">Please enter a valid description</div>
        </div>
        <div class="mb-4">
            <label for="image" class="form-label"  >Image Link</label> 
            <br>
            <input
            name="listing[image][url]"
            placeholder="Enter image URL"
            type="text"
            class="form-control"
            />
            <input
            name="listing[image][filename]"
            value="listingimage"
            type="hidden">
        </div>

        

        <div class="row">
            <div class="mb-3 col-md-8">
            <label for="country" class="form-label" >Country</label>
            <br>
            <input 
                name="listing[country]" 
                placeholder="enter country" 
                type="text"
                class="form-control"
                >
            <div class="invalid-feedback">Please enter a valid country</div>
                
            </div>

            <div class="mb-3 col-md-4">
            <label for="price" class="form-label" >Price</label>
            <br>
            <input 
            name="listing[price]" 
            placeholder="1200" 
            type="number"
            class="form-control">
            <div class="invalid-feedback">Please enter a valid price</div>
            
        </div>

            

        
            
        </div>

        <div class="mb-3 ">
                <label for="location" class="form-label" >Location</label>
                <br>
                <input 
                name="listing[location]" 
                placeholder="enter location" 
                type="text"
                class="form-control"
                >
                <div class="invalid-feedback">Location should be valid</div>

        </div>
         
        

        
         
        
        <br><br>
        <button class="btn btn-dark add-btn">add</button>
        
    </form>
    </div>
</div>    
 
 